# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL for the VersionDB backend API.
# Leave empty if no backend service is deployed yet; the frontend will render
# truthful "Backend Not Configured" states instead of fabricated data.
VITE_API_BASE_URL="http://localhost:3000/api"

# --- Backend Service Configuration ---
PORT=3000
NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/versiondb"
DB_POOL_MAX=10
JWT_ACCESS_SECRET="versiondb-development-jwt-access-secret-minimum-32-chars-long"
JWT_ISSUER="versiondb"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_COST=12
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
DATA_DIR="./data"
DEFAULT_REQUIRED_APPROVALS=1
LOG_LEVEL="info"

